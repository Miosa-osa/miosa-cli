{
  "name": "@miosa/cli",
  "version": "1.0.47",
  "description": "MIOSA platform CLI — projects, sandboxes, deploys, databases, more",
  "type": "module",
  "bin": {
    "miosa": "dist/bin/miosa.js"
  },
  "scripts": {
    "build": "tsc",
    "build:linux": "bun build src/bin/miosa.ts --compile --target=bun-linux-x64 --outfile dist/miosa-linux-x64",
    "dev": "tsx src/bin/miosa.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "miosa",
    "cli",
    "platform",
    "paas",
    "deploy",
    "sandbox",
    "serverless",
    "opencomputers",
    "devtools"
  ],
  "author": "MIOSA",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^7.0.3",
    "inquirer": "^9.3.7",
    "ora": "^8.1.1",
    "react": "^19.2.6",
    "undici": "^6.19.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.8",
    "@types/node": "^20.17.9",
    "@types/react": "^19.2.15",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
